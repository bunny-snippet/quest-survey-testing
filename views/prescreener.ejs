<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Survey eligibility</title>
    <meta name="description" content="Complete the short eligibility check to begin the survey.">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-page app-page-centered">
<header class="site-header site-header-floating">
    <a class="brand" href="/" aria-label="Survey home"><span class="brand-mark">Q</span><span>Quest Research</span></a>
    <span class="secure-pill"><span class="secure-dot"></span>Secure survey</span>
</header>
<main class="compact-shell">
    <div class="step-line"><span class="active"></span><span></span></div>
    <section class="compact-card" aria-labelledby="prescreener-title">
        <p class="eyebrow">Step 1 of 2</p>
        <h1 id="prescreener-title">Let's see if you qualify</h1>
        <p class="intro">Two quick details before we begin. It takes less than a minute.</p>
        <% if (errors.length) { %>
            <div class="error-box" role="alert"><% errors.forEach(function(error) { %><p><%= error %></p><% }); %></div>
        <% } %>
        <form method="post" action="/prescreener" class="form-stack compact-form">
            <label class="field" for="age">
                <span>Your age</span>
                <input id="age" name="age" type="number" min="18" max="99" step="1" inputmode="numeric"
                    autocomplete="off" placeholder="e.g. 28" value="<%= values.age %>" aria-describedby="age-hint" required>
                <small id="age-hint">You must be between 18 and 99.</small>
            </label>
            <fieldset class="field">
                <legend>Gender</legend>
                <div class="choice-grid choice-grid-two">
                    <label class="choice-card"><input type="radio" name="gender" value="male"
                        <%= values.gender === 'male' ? 'checked' : '' %> required><span>Male</span></label>
                    <label class="choice-card"><input type="radio" name="gender" value="female"
                        <%= values.gender === 'female' ? 'checked' : '' %> required><span>Female</span></label>
                </div>
            </fieldset>
            <div class="button-row">
                <button class="button button-primary" type="submit">Continue <span aria-hidden="true">&rarr;</span></button>
                <button class="button button-quiet" type="reset">Reset</button>
            </div>
        </form>
    </section>
    <p class="privacy-note">Your responses are protected and used only for this research session.</p>
</main>
</body>
</html>
